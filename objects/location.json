{
  "caption": "Geo Location",
  "description": "Adds physical site context to the core Geo Location object when the Physical Site profile is applied.",
  "extends": "location",
  "profiles": [
    "physical_site"
  ],
  "attributes": {
    "site_uid": {
      "requirement": "optional"
    },
    "site_name": {
      "requirement": "optional"
    },
    "building": {
      "requirement": "optional"
    },
    "floor": {
      "requirement": "optional"
    }
  }
}
